{
  "name": "@digital-twin/contracts",
  "version": "0.1.0",
  "description": "Shared TypeScript contracts and API schemas for the digital-twin monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "domain.schema.json",
    "run-bundle.schema.json",
    "inspection-package-v2.schema.json",
    "websocket-events.schema.json",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.5"
  },
  "license": "UNLICENSED",
  "private": true
}
