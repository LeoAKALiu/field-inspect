# Export these in the shell; the API does not automatically load this file.
# Mac launcher defaults; keep API and CLI on the same persistent paths.
# TWIN_DB_PATH="$HOME/Library/Application Support/FieldInspect/twin.db"
# TWIN_IMPORT_ROOT="$HOME/Library/Application Support/FieldInspect/imports"

# Simulation tick period in milliseconds (default 1000)
# TWIN_SIM_TICK_MS=1000

# Simulation random seed (default 42)
# TWIN_SEED=42
